{
  // In a .md file type "post" then Ctrl+Space (or run "Insert Snippet").
  "Blog post front matter": {
    "scope": "markdown",
    "prefix": "post",
    "body": [
      "---",
      "title: ${1:Title}",
      "date: $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE",
      "tags: ${2:tag}",
      "summary: ${3:One line for the list page.}",
      "---",
      "",
      "$0"
    ]
  }
}
